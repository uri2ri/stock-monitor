# 로컬 테스트용 .env 파일 예시
# 이 파일을 .env로 복사하고 값을 채워주세요.

NOTION_TOKEN=
NOTION_DB_ID=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REFRESH_TOKEN=
TOTAL_CAPITAL=

# Gmail 상세 리포트 메일 (비워두면 메일 발송을 건너뜁니다)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_TO=

# KIS(한국투자증권) 모의투자 Open API
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT=
# 자동주문 기록 DB (노션) - 일일 상한/중복 방지 판단 기준
NOTION_ORDERS_DB_ID=
# KIS 접근토큰 캐시 DB (노션) - 만료시각까지 재발급 없이 재사용
NOTION_TOKEN_CACHE_DB_ID=ce9a830c2c164a628ff684ed96f1d111
# 매매일지 (청산 기록) DB (노션) - evening_audit.py가 청산 신호 지연일수 감사에 사용
NOTION_LEDGER_DB_ID=
# 자동매매 제어 DB (노션) - 상태를 "일시정지"로 바꾸면 신규 진입·추가매수만 멈춘다
# (자동매도는 무관하게 항상 동작). 조회 실패 시 fail-closed로 정지 취급.
NOTION_AUTO_TRADE_CONTROL_DB_ID=c9e8c55af32f49779cd70b79719174bd
# 돌파 후 미진입 추적 DB (노션) - 비워 두면 추적 기능 전체가 비활성이다.
# 스키마와 설정 방법은 BREAKOUT_TRACKING.md 참고. (운영 미반영: DB 미생성)
NOTION_BREAKOUT_TRACK_DB_ID=
# 추적 행을 만들고 고치는 유일한 프로세스 표시. auto-trade 워크플로에만
# "auto-trade"로 준다 - 다른 프로세스에서는 읽기만 하고 쓰지 않는다.
BREAKOUT_TRACK_WRITER=
