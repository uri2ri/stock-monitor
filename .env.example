# 로컬 테스트용 .env 파일 예시
# 이 파일을 .env로 복사하고 값을 채워주세요.

NOTION_TOKEN=
NOTION_DB_ID=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REFRESH_TOKEN=
TOTAL_CAPITAL=

# Gmail 상세 리포트 메일 (비워두면 메일 발송을 건너뜁니다)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_TO=

# KIS(한국투자증권) 모의투자 Open API
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT=
# 자동주문 기록 DB (노션) - 일일 상한/중복 방지 판단 기준
NOTION_ORDERS_DB_ID=
# KIS 접근토큰 캐시 DB (노션) - 만료시각까지 재발급 없이 재사용
NOTION_TOKEN_CACHE_DB_ID=ce9a830c2c164a628ff684ed96f1d111
