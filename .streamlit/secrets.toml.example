# Streamlit 시크릿 예시
# 이 파일을 secrets.toml로 복사해 값을 채우세요 (secrets.toml은 .gitignore 대상).
# Streamlit Community Cloud에서는 앱 설정 → Secrets에 같은 내용을 붙여넣습니다.
#
# ⚠️ 이 예시 파일은 저장소에 그대로 커밋됩니다. 실제 값은 절대 여기에 쓰지 말고
#    복사본(secrets.toml)이나 Cloud의 Secrets 설정에만 넣으세요.

# AI 의견 버튼 잠금용 비밀번호. 비워두면 AI 기능이 잠긴 상태로 유지됩니다.
APP_PASSWORD = ""

# Anthropic API 키 (AI 의견 호출용)
ANTHROPIC_API_KEY = ""
